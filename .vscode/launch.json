{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run API",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/apps/backend/EsriExample/bin/Debug/net10.0/EsriExample",
      "cwd": "${workspaceFolder}/apps/backend/EsriExample",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    {
      "name": "Run Web App",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm run dev:frontend",
      "cwd": "${workspaceFolder}"
    },
  ],
  "compounds": [
    {
      "name": "Run Full Stack",
      "configurations": [
        "Run API",
        "Run Web App"
      ],
      "stopAll": true
    }
  ]
}
